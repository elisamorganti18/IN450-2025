Cell[CellGroupData[{

Cell["Left circular shift", "Subsection",
 CellChangeTimes->{{3.999568878850065*^9, 
  3.9995688834001446`*^9}},ExpressionUUID->"39f59b5c-34c6-e541-b553-\
68592f08fbaa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LeftRotate5", "[", "x_Integer", "]"}], ":=", 
   RowBox[{"BitOr", "[", 
    RowBox[{
     RowBox[{"BitAnd", "[", 
      RowBox[{
       RowBox[{"BitShiftLeft", "[", 
        RowBox[{"x", ",", "5"}], "]"}], ",", "16^^FFFFFFFF"}], "]"}], ",", 
     RowBox[{"BitShiftRight", "[", 
      RowBox[{"x", ",", "27"}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.999760866208372*^9, 3.9997608664936447`*^9}},
 CellLabel->
  "In[248]:=",ExpressionUUID->"70c2dbac-47eb-e249-88a4-37b58a0c5c2f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Round function", "Subsection",
 CellChangeTimes->{{3.999568972182703*^9, 
  3.999568975598528*^9}},ExpressionUUID->"05c328c1-b14a-704c-b42e-\
fb63b32dc781"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LELBCRound", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"X0_", ",", "X1_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"K0_", ",", "K1_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"A0", ",", "A1"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"A0", "=", 
       RowBox[{"BitXor", "[", 
        RowBox[{"X0", ",", "K0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"A1", "=", 
       RowBox[{"BitXor", "[", 
        RowBox[{"X1", ",", 
         RowBox[{"LeftRotate5", "[", "A0", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"A0", "=", 
       RowBox[{"ApplySubLayer", "[", "A0", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"A1", "=", 
       RowBox[{"ApplySubLayer", "[", "A1", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"A0", "=", 
       RowBox[{"BitXor", "[", 
        RowBox[{"A0", ",", 
         RowBox[{"LeftRotate5", "[", "A1", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"A1", "=", 
       RowBox[{"BitXor", "[", 
        RowBox[{"A1", ",", "K1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"A0", ",", "A1"}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9995290961837234`*^9, 3.9995290961837234`*^9}, {
   3.9995689794227085`*^9, 3.9995690001241283`*^9}, {3.999569106974766*^9, 
   3.9995691630672855`*^9}, {3.9997097240095367`*^9, 3.99970974103878*^9}, 
   3.9997608700195847`*^9},
 CellLabel->
  "In[249]:=",ExpressionUUID->"19dda256-4ad5-7546-bdb5-65589b35aa43"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Encrypt", "Subsection",
 CellChangeTimes->{{3.9995690385225754`*^9, 
  3.9995690401763535`*^9}},ExpressionUUID->"337640e7-56b5-0b43-a7db-\
24cdde8c508f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LELBCEncrypt", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"P0_", ",", "P1_"}], "}"}], ",", "subkeys_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "state", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"state", "=", 
       RowBox[{"Fold", "[", 
        RowBox[{"LELBCRound", ",", 
         RowBox[{"{", 
          RowBox[{"P0", ",", "P1"}], "}"}], ",", "subkeys"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"permutazione", " ", "finale", " ", "algoritmo", " ", "2"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Reverse", "[", "state", "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.9997074836555405`*^9, {3.9997097767892933`*^9, 3.9997098116321087`*^9}, 
   3.9997608810826263`*^9},
 CellLabel->
  "In[250]:=",ExpressionUUID->"6f109405-a4e5-7244-a8dc-39019afb9e0c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Round inverso", "Subsection",
 CellChangeTimes->{{3.9995690470916862`*^9, 
  3.9995690501432056`*^9}},ExpressionUUID->"ce0cb44d-afdf-8d49-80ed-\
09d682af264b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LELBCInverseRound", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"X0_", ",", "X1_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"K0_", ",", "K1_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A0", "=", "X0"}], ",", 
       RowBox[{"A1", "=", "X1"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"A1", "=", 
       RowBox[{"BitXor", "[", 
        RowBox[{"A1", ",", "K1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"A0", "=", 
       RowBox[{"BitXor", "[", 
        RowBox[{"A0", ",", 
         RowBox[{"LeftRotate5", "[", "A1", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"A0", "=", 
       RowBox[{"ApplySubLayer", "[", "A0", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"A1", "=", 
       RowBox[{"ApplySubLayer", "[", "A1", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"A1", "=", 
       RowBox[{"BitXor", "[", 
        RowBox[{"A1", ",", 
         RowBox[{"LeftRotate5", "[", "A0", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"A0", "=", 
       RowBox[{"BitXor", "[", 
        RowBox[{"A0", ",", "K0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"A0", ",", "A1"}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.9995693237219696`*^9, 3.9997074917940025`*^9, 
  3.9997101034671803`*^9, 3.999760884175617*^9},
 CellLabel->
  "In[251]:=",ExpressionUUID->"292dc69c-433d-8542-a1fd-f71d89f601a8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Decrypt", "Subsection",
 CellChangeTimes->{{3.9995690586346703`*^9, 
  3.999569061134226*^9}},ExpressionUUID->"05cb3fb6-b77b-924c-b756-\
7cb587ae44c1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LELBCDecrypt", "[", 
    RowBox[{"ciphertext_List", ",", "subkeys_List"}], "]"}], ":=", 
   RowBox[{"Fold", "[", 
    RowBox[{"LELBCInverseRound", ",", 
     RowBox[{"Reverse", "[", "ciphertext", "]"}], ",", 
