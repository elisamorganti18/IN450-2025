Cell[CellGroupData[{

Cell["KEY RECOVERY", "Section",
 CellChangeTimes->{{3.9995740961172066`*^9, 
  3.999574098605873*^9}},ExpressionUUID->"669dd75a-d3cf-834b-8e28-\
d9efd57ef295"],

Cell[CellGroupData[{

Cell["\<\
Uso i primi 3 round come distinguisher e il round 4 come round di key recovery.
In questo modo il distinguisher ha P=2^-16 e posso ottenere right pairs\
\>", "Subsection",
 CellChangeTimes->{{3.9995741093698425`*^9, 
  3.9995741586488857`*^9}},ExpressionUUID->"64531e26-df91-724f-b85e-\
300f2c0880e9"],

Cell["\<\
input round 4:
\[CapitalDelta]X0 = 00020000
\[CapitalDelta]X1 = 00001000

prima di entrare nel sublayer: \[CapitalDelta]X1 <- \[CapitalDelta]X1 XOR (\
\[CapitalDelta]X0 <<< 5) ovvero 00401000
dopo sublayer: \[CapitalDelta]X1 <- \[CapitalDelta]X1 XOR K1 ovvero 00801000\
\>", "Text",
 CellChangeTimes->{{3.999751717441042*^9, 3.9997517426159267`*^9}, {
  3.999751777913872*^9, 3.999751807881325*^9}, {3.999751922082506*^9, 
  3.999751945101532*^9}, {3.999752915901182*^9, 
  3.9997529445042114`*^9}},ExpressionUUID->"0cb25d77-c4c4-784a-88da-\
8b18f8070573"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "DIFFERENZA", " ", "INTERNA", " ", "DEL", " ", "ROUND", " ", "DI", " ", 
    "KEY", " ", "RECOVERY"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"recoveryRound", "=", "4"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"recoveryInputDiff", "=", 
     RowBox[{"characteristic", "[", 
      RowBox[{"[", "recoveryRound", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Delta", " ", 
     RowBox[{"all", "'"}], "ingresso", " ", "del", " ", "sublayer", " ", 
     "destro", " ", "del", " ", "round", " ", "4"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"targetSBoxInput1", "=", 
     RowBox[{"BitXor", "[", 
      RowBox[{
       RowBox[{"recoveryInputDiff", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", 
       RowBox[{"LeftRotate5", "[", 
        RowBox[{"recoveryInputDiff", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\[CapitalDelta]X1 ingresso S-box al 4 round \>\"", ",", 
      "recoveryRound", ",", "\"\<: \>\"", ",", 
      RowBox[{"IntegerString", "[", 
       RowBox[{"targetSBoxInput1", ",", "16", ",", "8"}], "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.999530940738302*^9, 3.9995309407403126`*^9}, {
   3.999576582149515*^9, 3.999576595153364*^9}, 3.999751474808325*^9, {
   3.9997515185735493`*^9, 3.999751591449417*^9}, {3.9997516226220455`*^9, 
