Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"RACCOLTA", " ", "COPPIE", " ", 
    RowBox[{"CANDIDATE", ":", " ", "\[IndentingNewLine]", 
     RowBox[{
     "seleziono", " ", "direttamente", " ", "i", " ", "ciphertext", " ", 
      "che", " ", "hanno", " ", "una", " ", "differenza", " ", "compatibile", 
      " ", "con", " ", "il", " ", "round", " ", "finale"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"inputDiffKR", "=", 
     RowBox[{"characteristic", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"expectedOutputAfterRecovery", "=", 
     RowBox[{"characteristic", "[", 
      RowBox[{"[", 
       RowBox[{"recoveryRound", "+", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "differenza", " ", "prevista", " ", "ramo", " ", "destro", " ", "dopo", " ",
      "round"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"expectedRightBranchDiff", "=", 
     RowBox[{"expectedOutputAfterRecovery", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"activeOutputMask", "=", 
     RowBox[{"Fold", "[", 
      RowBox[{"BitOr", ",", "0", ",", 
       RowBox[{"MapIndexed", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"#1", "!=", "0"}], ",", 
            RowBox[{"BitShiftLeft", "[", 
             RowBox[{"16^^F", ",", 
              RowBox[{"4", "*", 
               RowBox[{"(", 
                RowBox[{"8", "-", 
                 RowBox[{"First", "[", "#2", "]"}]}], ")"}]}]}], "]"}], ",", 
            "0"}], "]"}], "&"}], ",", 
         RowBox[{"IntegerDigits", "[", 
          RowBox[{"expectedRightBranchDiff", ",", "16", ",", "8"}], "]"}]}], 
        "]"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\[CapitalDelta]X1 uscita S-box al 4 round \>\"", ",", 
      "recoveryRound", ",", "\"\<: \>\"", ",", 
      RowBox[{"IntegerString", "[", 
       RowBox[{"expectedRightBranchDiff", ",", "16", ",", "8"}], "]"}]}], 
     "]"}], ";"}], " ", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Maschera nibble attivi: \>\"", ",", 
      RowBox[{"IntegerString", "[", 
       RowBox[{"activeOutputMask", ",", "16", ",", "8"}], "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9995310257253532`*^9, 3.9995310257273617`*^9}, {
