Cell[CellGroupData[{

Cell["VERIFICA EMPIRICA", "Subsection",
 CellChangeTimes->{{3.999572883576338*^9, 
  3.999572887732624*^9}},ExpressionUUID->"7fa1d7f7-0b5f-d844-9c3a-\
3dc46c37fbb9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "cifratura", " ", "che", " ", "restituisce", " ", "gli", " ", "stati", " ",
      "intermedi", " ", "di", " ", "ogni", " ", "round"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
    "per", " ", "vedere", " ", "se", " ", "una", " ", "coppia", " ", "segue", 
     " ", "la", " ", "specifica", " ", "caratteristica", " ", "differenziale",
      " ", "del", " ", "paper"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"LELBCEncryptTrace", "[", 
     RowBox[{"plaintext_List", ",", "subkeys_List"}], "]"}], ":=", 
    RowBox[{"Rest", "[", 
     RowBox[{"FoldList", "[", 
      RowBox[{"LELBCRound", ",", "plaintext", ",", "subkeys"}], "]"}], 
     "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.999573539935335*^9, 3.999573580698799*^9}, 
   3.9995739465807724`*^9, {3.9995743135062904`*^9, 3.9995743167971783`*^9}, {
   3.999575834332535*^9, 3.999575887434164*^9}, 3.9995762783268967`*^9, {
   3.9997610127756805`*^9, 3.9997610170914993`*^9}},
 CellLabel->
  "In[281]:=",ExpressionUUID->"edee5390-c549-534b-abf1-469f175d51c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "VERIFICA", " ", "EMPIRICA", " ", "DI", " ", "UN", " ", "PREFISSO", " ", 
    "DELLA", " ", "CARATTERISTICA"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"EmpiricalCharacteristicTest", "[", 
     RowBox[{"rounds_Integer", ",", "nTests_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"masterKey", ",", "keys", ",", 
        RowBox[{"matchesTrail", "=", "0"}], ",", 
        RowBox[{"matchesOutput", "=", "0"}], ",", "P", ",", "Pprime", ",", 
        "trace", ",", "tracePrime", ",", "differences", ",", 
        "expectedDifferences"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"masterKey", "=", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", "16^^FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF"}], "}"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"keys", "=", 
        RowBox[{"LELBCKeySchedule", "[", 
         RowBox[{"masterKey", ",", "rounds"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "differenze", " ", "previste", " ", "DOPO", " ", "ciascun", " ", 
         "round"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"expectedDifferences", "=", 
        RowBox[{"characteristic", "[", 
         RowBox[{"[", 
          RowBox[{"2", ";;", 
           RowBox[{"rounds", "+", "1"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"P", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"RandomInteger", "[", 
              RowBox[{"{", 
               RowBox[{"0", ",", "16^^FFFFFFFF"}], "}"}], "]"}], ",", 
             RowBox[{"RandomInteger", "[", 
              RowBox[{"{", 
               RowBox[{"0", ",", "16^^FFFFFFFF"}], "}"}], "]"}]}], "}"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"Pprime", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"BitXor", "[", 
              RowBox[{
               RowBox[{"P", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"characteristic", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], ",", 
             RowBox[{"BitXor", "[", 
              RowBox[{
               RowBox[{"P", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", 
               RowBox[{"characteristic", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "]"}]}], "}"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"trace", "=", 
           RowBox[{"LELBCEncryptTrace", "[", 
            RowBox[{"P", ",", "keys"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"tracePrime", "=", 
           RowBox[{"LELBCEncryptTrace", "[", 
            RowBox[{"Pprime", ",", "keys"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"differences", "=", 
           RowBox[{"MapThread", "[", 
            RowBox[{"BitXor", ",", 
             RowBox[{"{", 
              RowBox[{"trace", ",", "tracePrime"}], "}"}], ",", "2"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"solo", " ", "differenza", " ", "finale"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Last", "[", "differences", "]"}], "===", 
             RowBox[{"Last", "[", "expectedDifferences", "]"}]}], ",", 
            RowBox[{"matchesOutput", "++"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"intera", " ", "caratteristica"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"differences", "===", "expectedDifferences"}], ",", 
            RowBox[{"matchesTrail", "++"}]}], "]"}], ";"}], ",", 
         RowBox[{"{", "nTests", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Tests\>\"", "->", "nTests"}], ",", 
         RowBox[{"\"\<Characteristic Matches\>\"", "->", "matchesTrail"}], ",", 
         RowBox[{"\"\<Characteristic Empirical Probability\>\"", "->", 
          RowBox[{"N", "[", 
           RowBox[{"matchesTrail", "/", "nTests"}], "]"}]}], ",", 
         RowBox[{"\"\<Characteristic Theoretical Probability\>\"", "->", 
          RowBox[{"N", "[", 
           RowBox[{"cumulativeProbabilities", "[", 
            RowBox[{"[", 
             RowBox[{"rounds", "+", "1"}], "]"}], "]"}], "]"}]}], ",", 
         RowBox[{"\"\<Output Differential Matches\>\"", "->", 
          "matchesOutput"}], ",", 
         RowBox[{"\"\<Output Differential Probability\>\"", "->", 
          RowBox[{"N", "[", 
           RowBox[{"matchesOutput", "/", "nTests"}], "]"}]}]}], "|>"}]}]}], 
     "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.999530331356596*^9, 3.9995303313589497`*^9}, {
  3.9995712454558907`*^9, 3.999571263893276*^9}, {3.999571350834532*^9, 
  3.999571364950239*^9}, {3.999573655309683*^9, 3.99957372139748*^9}, {
  3.9997478828825283`*^9, 3.999747889839176*^9}, {3.9997486934795628`*^9, 
