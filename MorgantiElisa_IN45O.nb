Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"PROBABILITA", "'"}], " ", "DI", " ", "UNA", " ", "TRANSIZIONE", " ",
     "DI", " ", "ROUND"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"RoundCharacteristicProbability", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dx0_", ",", "dx1_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"nextDx0_", ",", "nextDx1_"}], "}"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "sboxInput0", ",", "sboxInput1", ",", "sboxOutput0", ",", 
        "sboxOutput1", ",", "p0", ",", "p1"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"sboxInput0", "=", "dx0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"sboxInput1", "=", 
        RowBox[{"BitXor", "[", 
         RowBox[{"dx1", ",", 
          RowBox[{"LeftRotate5", "[", "dx0", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sboxOutput1", "=", "nextDx1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"sboxOutput0", "=", 
        RowBox[{"BitXor", "[", 
         RowBox[{"nextDx0", ",", 
          RowBox[{"LeftRotate5", "[", "sboxOutput1", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"p0", "=", 
        RowBox[{"SubLayerDiffProbability", "[", 
         RowBox[{"sboxInput0", ",", "sboxOutput0"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"p1", "=", 
        RowBox[{"SubLayerDiffProbability", "[", 
         RowBox[{"sboxInput1", ",", "sboxOutput1"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"p0", "*", "p1"}]}]}], "]"}]}], ";"}]}]], "Input",
