Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"PROBABILITA", "'"}], " ", "DEL", " ", "SUBLAYER", " ", "A", " ", 
    "32", " ", "BIT"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"SubLayerDiffProbability", "[", 
     RowBox[{"inputDiff_Integer", ",", "outputDiff_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"inNibbles", ",", "outNibbles", ",", "probabilities"}], "}"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"inNibbles", "=", 
        RowBox[{"IntegerDigits", "[", 
         RowBox[{"inputDiff", ",", "16", ",", "8"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"outNibbles", "=", 
        RowBox[{"IntegerDigits", "[", 
         RowBox[{"outputDiff", ",", "16", ",", "8"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"probabilities", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{"SBoxDiffProbability", ",", 
          RowBox[{"{", 
           RowBox[{"inNibbles", ",", "outNibbles"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Times", "@@", "probabilities"}]}]}], "]"}]}], 
   ";"}]}]], "Input",
