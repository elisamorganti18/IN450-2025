Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"2", "^", "8"}], "=", 
    RowBox[{"256", " ", "GUESS"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"guessResults", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"nibbleA", ",", "nibbleB", ",", "partialKey", ",", "hits"}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"nibbleA", "=", 
          RowBox[{"BitAnd", "[", 
           RowBox[{"guess", ",", "16^^F"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"nibbleB", "=", 
          RowBox[{"BitAnd", "[", 
           RowBox[{
            RowBox[{"BitShiftRight", "[", 
             RowBox[{"guess", ",", "4"}], "]"}], ",", "16^^F"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"partialKey", "=", 
          RowBox[{"BitOr", "[", 
           RowBox[{
            RowBox[{"BitShiftLeft", "[", 
             RowBox[{"nibbleA", ",", 
              RowBox[{"4", " ", 
               RowBox[{"activeInputPositions", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], ",", 
            RowBox[{"BitShiftLeft", "[", 
             RowBox[{"nibbleB", ",", 
              RowBox[{"4", " ", 
               RowBox[{"activeInputPositions", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"hits", "=", 
          RowBox[{"Count", "[", 
           RowBox[{"candidatePairs", ",", 
            RowBox[{"pair_", "/;", "\[IndentingNewLine]", 
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"u", ",", "uprime", ",", "du"}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", 
                RowBox[{"inversione", " ", 
                 RowBox[{"dell", "'"}], "ultimo", " ", "XOR", " ", "con", " ",
                  "K1", " ", "e", " ", 
                 RowBox[{"dell", "'"}], "sbox", " ", "sui", " ", "nibble", " ",
                  "interessati"}], "*)"}], "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"u", "=", 
                 RowBox[{"ApplySubLayer", "[", 
                  RowBox[{"BitXor", "[", 
                   RowBox[{
                    RowBox[{"pair", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
                    "partialKey"}], "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"uprime", "=", 
                 RowBox[{"ApplySubLayer", "[", 
                  RowBox[{"BitXor", "[", 
                   RowBox[{
                    RowBox[{"pair", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "1"}], "]"}], "]"}], ",", 
                    "partialKey"}], "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"du", "=", 
                 RowBox[{"BitXor", "[", 
                  RowBox[{"u", ",", "uprime"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                 "controllo", " ", "soltanto", " ", "i", " ", "nibble", " ", 
                  "oggetto", " ", "del", " ", "guess"}], "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{"And", "@@", 
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"BitAnd", "[", 
                    RowBox[{
                    RowBox[{"BitShiftRight", "[", 
                    RowBox[{"du", ",", 
                    RowBox[{"4", " ", "pos"}]}], "]"}], ",", "16^^F"}], "]"}],
                     "==", 
                    RowBox[{"BitAnd", "[", 
                    RowBox[{
                    RowBox[{"BitShiftRight", "[", 
                    RowBox[{"targetSBoxInput1", ",", 
                    RowBox[{"4", " ", "pos"}]}], "]"}], ",", "16^^F"}], 
                    "]"}]}], ",", 
                   RowBox[{"{", 
                    RowBox[{"pos", ",", "activeInputPositions"}], "}"}]}], 
                  "]"}]}]}]}], "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"guess", ",", "partialKey", ",", "hits"}], "}"}]}]}], "]"}],
       ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"guess", ",", "0", ",", "255"}], "}"}]}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.999531334043312*^9, 3.999531334043312*^9}, {
  3.9995807744425716`*^9, 3.999580797316416*^9}, {3.9996123345044537`*^9, 
