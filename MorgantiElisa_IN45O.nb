Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"candidatePairs", "=", 
    RowBox[{
     RowBox[{"Reap", "[", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "P", ",", "Pprime", ",", "C", ",", "Cprime", ",", 
            "diffFirstCipherWord"}], "}"}], ",", 
          RowBox[{
           RowBox[{"P", "=", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"RandomInteger", "[", 
               RowBox[{"{", 
                RowBox[{"0", ",", "16^^FFFFFFFF"}], "}"}], "]"}], ",", 
              RowBox[{"RandomInteger", "[", 
               RowBox[{"{", 
                RowBox[{"0", ",", "16^^FFFFFFFF"}], "}"}], "]"}]}], "}"}]}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"Pprime", "=", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"BitXor", "[", 
               RowBox[{
                RowBox[{"P", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"inputDiffKR", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
              RowBox[{"BitXor", "[", 
               RowBox[{
                RowBox[{"P", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", 
                RowBox[{"inputDiffKR", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"C", "=", 
            RowBox[{"LELBCEncrypt", "[", 
             RowBox[{"P", ",", "keysKR"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Cprime", "=", 
            RowBox[{"LELBCEncrypt", "[", 
             RowBox[{"Pprime", ",", "keysKR"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"dopo", " ", "lo", " ", "swap", " ", "finale", " ", 
             RowBox[{"C", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "\[EGrave]", " ", "il", " ",
              "ramo", " ", "X1"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"diffFirstCipherWord", "=", 
            RowBox[{"BitXor", "[", 
             RowBox[{
              RowBox[{"C", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"Cprime", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "le", " ", "differenze", " ", "al", " ", "di", " ", "fuori", " ", 
             "dei", " ", "nibble", " ", "attivi", " ", "devono", " ", 
             "essere", " ", "zero"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"BitAnd", "[", 
               RowBox[{"diffFirstCipherWord", ",", 
                RowBox[{"BitXor", "[", 
                 RowBox[{"activeOutputMask", ",", "16^^FFFFFFFF"}], "]"}]}], 
               "]"}], "==", "0"}], ",", "\[IndentingNewLine]", 
             RowBox[{"Sow", "[", 
              RowBox[{"{", 
               RowBox[{"C", ",", "Cprime"}], "}"}], "]"}]}], "]"}], ";"}]}], 
         "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", "NtestsKR", "}"}]}], "]"}], "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"candidatePairs", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"candidatePairs", "===", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"{", "}"}], ",", 
      RowBox[{"First", "[", "candidatePairs", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Coppie candidate dopo il filtro: \>\"", ",", 
    RowBox[{"Length", "[", "candidatePairs", "]"}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.999531044439169*^9, 3.999531044446577*^9}, {
