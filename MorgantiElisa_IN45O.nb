Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"DDTMatrix", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Count", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"BitXor", "[", 
           RowBox[{
            RowBox[{"SBox", "[", 
             RowBox[{"[", 
              RowBox[{"x", "+", "1"}], "]"}], "]"}], ",", 
            RowBox[{"SBox", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"BitXor", "[", 
                RowBox[{"x", ",", "dx"}], "]"}], "+", "1"}], "]"}], "]"}]}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0", ",", "15"}], "}"}]}], "]"}], ",", "dy"}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"dx", ",", "0", ",", "15"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"dy", ",", "0", ",", "15"}], "}"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Difference distribution table:\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{"MatrixForm", "[", "DDTMatrix", "]"}]}], "Input",
