Cell[CellGroupData[{

Cell["TEST ENCRYPT/DECRYPT", "Subsubsection",
 CellChangeTimes->{{3.9995691900751286`*^9, 
  3.9995691939917183`*^9}},ExpressionUUID->"9352ad62-53bc-9d4b-9016-\
ea89e26a6463"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"testMasterKey", "=", "16^^0123456789ABCDEFFEDCBA9876543210"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"testPlaintext", "=", 
   RowBox[{"{", 
    RowBox[{"16^^01234567", ",", "16^^89ABCDEF"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"testKeys", "=", 
   RowBox[{"LELBCKeySchedule", "[", 
    RowBox[{"testMasterKey", ",", "16"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"testCiphertext", "=", 
   RowBox[{"LELBCEncrypt", "[", 
    RowBox[{"testPlaintext", ",", "testKeys"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"testDecrypted", "=", 
    RowBox[{"LELBCDecrypt", "[", 
     RowBox[{"testCiphertext", ",", "testKeys"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Plaintext:  \>\"", ",", 
    RowBox[{"BaseForm", "[", 
     RowBox[{"testPlaintext", ",", "16"}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Ciphertext: \>\"", ",", 
    RowBox[{"BaseForm", "[", 
     RowBox[{"testCiphertext", ",", "16"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Decrypted:  \>\"", ",", 
    RowBox[{"BaseForm", "[", 
     RowBox[{"testDecrypted", ",", "16"}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Encrypt/Decrypt corretto? \>\"", ",", 
    RowBox[{"testPlaintext", "===", "testDecrypted"}]}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9995291276304665`*^9, 3.9995291276304665`*^9}, {
