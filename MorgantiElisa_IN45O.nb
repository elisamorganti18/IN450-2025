Cell[CellGroupData[{

Cell["Key schedule", "Subsection",
 CellChangeTimes->{
  3.999528703632393*^9},ExpressionUUID->"61787239-4620-3041-9ed2-\
9f273de232ba"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LELBCKeySchedule", "[", 
    RowBox[{"masterKey128_Integer", ",", 
     RowBox[{"numRounds_Integer", ":", "16"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"keyState", ",", 
       RowBox[{"subkeys", "=", 
        RowBox[{"{", "}"}]}], ",", "k124to127", ",", "k121to124", ",", 
       "kLeft", ",", "kRight", ",", "i"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "la", " ", "chiave", " ", "\[EGrave]", " ", "un", " ", "vettore", " ", 
        "di", " ", "128", " ", "bit", "\[IndentingNewLine]", 
        RowBox[{"keyState", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", "corrisponde", " ", "a", " ", 
        "k0"}], ",", " ", 
       RowBox[{
        RowBox[{"keyState", "[", 
         RowBox[{"[", "128", "]"}], "]"}], " ", "corrisponde", " ", "a", " ", 
        "k127"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"keyState", "=", 
       RowBox[{"IntegerDigits", "[", 
        RowBox[{"masterKey128", ",", "2", ",", "128"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", "numRounds"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"SBOX", " ", "SU", " ", "k124"}], "||", "k125", "||", 
          "k126", "||", "k127"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"k124to127", "=", 
          RowBox[{"FromDigits", "[", 
           RowBox[{
            RowBox[{"keyState", "[", 
             RowBox[{"[", 
              RowBox[{"125", ";;", "128"}], "]"}], "]"}], ",", "2"}], "]"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"keyState", "[", 
           RowBox[{"[", 
            RowBox[{"125", ";;", "128"}], "]"}], "]"}], "=", 
          RowBox[{"IntegerDigits", "[", 
           RowBox[{
            RowBox[{"SBox", "[", 
             RowBox[{"[", 
              RowBox[{"k124to127", "+", "1"}], "]"}], "]"}], ",", "2", ",", 
            "4"}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"XOR", " ", "i", " ", "CON", " ", "k121"}], "||", "k122", "||",
            "k123", "||", "k124"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"k121to124", "=", 
          RowBox[{"FromDigits", "[", 
           RowBox[{
            RowBox[{"keyState", "[", 
             RowBox[{"[", 
              RowBox[{"122", ";;", "125"}], "]"}], "]"}], ",", "2"}], "]"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"keyState", "[", 
           RowBox[{"[", 
            RowBox[{"122", ";;", "125"}], "]"}], "]"}], "=", 
          RowBox[{"IntegerDigits", "[", 
           RowBox[{
            RowBox[{"BitXor", "[", 
             RowBox[{"k121to124", ",", 
              RowBox[{"i", "-", "1"}]}], "]"}], ",", "2", ",", "4"}], "]"}]}],
          ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "ROTAZIONE", " ", "DELLA", " ", "CHIAVE", " ", "DI", " ", "64", " ",
            "BIT"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"keyState", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"keyState", "[", 
             RowBox[{"[", 
              RowBox[{"65", ";;", "128"}], "]"}], "]"}], ",", 
            RowBox[{"keyState", "[", 
             RowBox[{"[", 
              RowBox[{"1", ";;", "64"}], "]"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "ROTAZIONE", " ", "SINISTRA", " ", "DI", " ", "9", " ", "BIT", " ", 
           "DELLA", " ", "PRIMA", " ", 
           RowBox[{"META", "'"}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"kLeft", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"keyState", "[", 
             RowBox[{"[", 
              RowBox[{"10", ";;", "64"}], "]"}], "]"}], ",", 
            RowBox[{"keyState", "[", 
             RowBox[{"[", 
              RowBox[{"1", ";;", "9"}], "]"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "ROTAZIONE", " ", "SINISTRA", " ", "DI", " ", "15", " ", "BIT", " ",
            "DELLA", " ", "SECONDA", " ", 
           RowBox[{"META", "'"}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"kRight", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"keyState", "[", 
             RowBox[{"[", 
              RowBox[{"80", ";;", "128"}], "]"}], "]"}], ",", 
            RowBox[{"keyState", "[", 
             RowBox[{"[", 
              RowBox[{"65", ";;", "79"}], "]"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"keyState", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"kLeft", ",", "kRight"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"ESTRAZIONE", " ", "DELLA", " ", "ROUND", " ", "KEY"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"subkeys", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"FromDigits", "[", 
              RowBox[{
               RowBox[{"keyState", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ";;", "32"}], "]"}], "]"}], ",", "2"}], "]"}], ",", 
             RowBox[{"FromDigits", "[", 
              RowBox[{
               RowBox[{"keyState", "[", 
                RowBox[{"[", 
                 RowBox[{"33", ";;", "64"}], "]"}], "]"}], ",", "2"}], 
              "]"}]}], "}"}]}], "]"}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "subkeys"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9995287540971794`*^9, 3.999528754101534*^9}, {
   3.9995319619650745`*^9, 3.99953198802717*^9}, {3.999568415427105*^9, 
   3.9995684327873726`*^9}, {3.9995685022826424`*^9, 3.999568620216139*^9}, {
   3.9995693104816456`*^9, 3.999569310565489*^9}, {3.999707246155632*^9, 
   3.9997072603376656`*^9}, {3.999707466725006*^9, 3.999707477137577*^9}, 
   3.9997090972089195`*^9, 3.9997094965023212`*^9, {3.999760828499054*^9, 
   3.999760828815012*^9}, {3.9997618643185406`*^9, 3.9997619014223003`*^9}, {
   3.999761948197544*^9, 3.9997620024051533`*^9}},
 CellLabel->
  "In[246]:=",ExpressionUUID->"d518605c-677c-984a-8b41-495d68ee7f83"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sublayer", "Subsection",
 CellChangeTimes->{{3.9995688271293144`*^9, 
  3.999568831846775*^9}},ExpressionUUID->"5eeea7a1-565c-eb44-8a50-\
870f52d6002e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"applica", " ", 
    RowBox[{"l", "'"}], "sbox", " ", "a", " ", "un", " ", "intero", " ", "da",
     " ", "32", " ", "bit", " ", "decimale"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ApplySubLayer", "[", "x_Integer", "]"}], ":=", 
    RowBox[{"FromDigits", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"SBox", "[", 
         RowBox[{"[", 
          RowBox[{"#", "+", "1"}], "]"}], "]"}], "&"}], "/@", 
       RowBox[{"IntegerDigits", "[", 
        RowBox[{"x", ",", "16", ",", "8"}], "]"}]}], ",", "16"}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.9995289141507225`*^9, 3.99952891415876*^9}, 
   3.9995319660239925`*^9, {3.999568838738125*^9, 3.999568857091921*^9}, {
   3.9995688912860584`*^9, 3.99956889863262*^9}, {3.999760855444195*^9, 
   3.9997608768870983`*^9}},
 CellLabel->
  "In[247]:=",ExpressionUUID->"22ac5ad0-6d82-dc48-bf9c-dcd496e625e8"]
